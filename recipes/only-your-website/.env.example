# Copy to .env and fill in. .env is gitignored; keep it that way.

# The access point of the A2A surface on YOUR OWN gateway, in front of the
# Lab's suggestions agent.
A2A_ACCESS_POINT=

# What the site calls itself in each message. Your gateway signs it, but the
# site chose it, so it says nothing a policy can trust.
A2A_AGENT_NAME="Suggestions Website"

# The Lab sign-in client for this site. Every participant's copy shares it.
SITE_CLIENT_ID=lab-starter-site
