# Copy to .env and fill in. .env is gitignored; keep it that way.

# The access point of the A2A surface you create on YOUR OWN gateway.
# Not the Lab's resource URL — that address does not admit you.
A2A_ACCESS_POINT=

# What this client calls itself. Your gateway hashes this into your DID, so
# changing it gives you a different DID. Leave it alone until you have a
# working run to compare against.
A2A_AGENT_NAME="A2A Test Client"
A2A_AGENT_VERSION=1.0.0

# There is deliberately no API key here. The key that opens the Lab's agent
# goes into your gateway as target authentication, and never into this client.
